goId0 = get_new(pageId, "Text");
// Text:
	set(goId0, "String", "interpolate_swept_lp_data_XdB() is a function added to the ADS 2011.10 release.\nThe parameters are (gain, desired_XdB_GainComp, response, interpStepSize, interpType, allowextrap).\nThe gain and response variables must have the same dimensionality.\nFor each independent variable, the function interpolates the gain, finds the\nmaximum gain then finds the gain that is X dB lower (and above) the maximum gain point.\nIt then interpolates the response and finds the value that corresponds to this gain compression point.\nIf you specify a desired gain compression that is beyond the gain compression at the maximum input power and\nthe allowextrap parameter is set to \"Yes\", then the function will perform a linear extrapolation using the\nlast 2 interpolated points.\nIf allowextrap is set to \"No\", then no extrapolation will occur and the last point in the response will be \nused.");
	_DDSobjectRestoreFont_(goId0, "Font", "Roboto", "Arial For CAE");
